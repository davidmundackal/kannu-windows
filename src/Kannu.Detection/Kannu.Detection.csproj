<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Passive detection that reads other apps' SQLite databases (Cursor's state.vscdb, Warp's history).
    Kept out of Kannu.Core so kannu-hook.exe, which runs on every agent event, never carries SQLite.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kannu.Core\Kannu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kannu.Core.Tests" />
  </ItemGroup>

</Project>
