<Project Sdk="Microsoft.NET.Sdk">

  <!--
    kannu-hook.exe: what Claude Code runs on every hook event. Published Native AOT so it starts in
    milliseconds and needs no .NET runtime, Python or bash on the user's machine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>kannu-hook</AssemblyName>
    <RootNamespace>Kannu.Hook</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- LibraryImport (console window check) generates marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Click-through: records the window the agent runs in. Shared with the app. -->
    <Compile Include="..\Shared\HostProcess.cs" Link="HostProcess.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kannu.Core\Kannu.Core.csproj" />
  </ItemGroup>

</Project>
