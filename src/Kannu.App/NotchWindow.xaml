<Window x:Class="Kannu.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kannu"
        Width="460" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
      The window is sized once to the largest the notch can grow and never moves or resizes; only the
      Pill inside it animates. Everything outside the Pill is fully transparent, and a layered window
      passes clicks through fully transparent pixels, so the spare area never blocks the desktop.
    -->
    <Window.Resources>
        <DataTemplate x:Key="DotTemplate">
            <Ellipse Width="8" Height="8" Margin="3,0" Fill="{Binding Brush}" />
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Brush}" />
                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                           Text="{Binding Title}" Foreground="#FFFFFFFF" FontSize="13"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Text="{Binding Detail}" Foreground="#99FFFFFF" FontSize="12" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Pill"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Width="200" Height="32"
            CornerRadius="0,0,16,16"
            Background="#F2121214" BorderBrush="#22FFFFFF" BorderThickness="1,0,1,1"
            ClipToBounds="True"
            MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave">
        <Grid>
            <!-- Collapsed row; stays as the header when expanded. -->
            <StackPanel Height="32" VerticalAlignment="Top" HorizontalAlignment="Center" Orientation="Horizontal">
                <!-- Kannu's eye while nothing is running, as in the macOS menu bar. -->
                <TextBlock VerticalAlignment="Center" Text="&#xE890;" FontSize="14" Foreground="#D9FFFFFF"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSessions}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl VerticalAlignment="Center" Focusable="False"
                              ItemsSource="{Binding Dots}" ItemTemplate="{StaticResource DotTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Margin="6,0,0,0" MaxWidth="150" VerticalAlignment="Center"
                           Text="{Binding Summary}" Foreground="#D9FFFFFF" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="ExpandedContent" Margin="16,36,16,12" VerticalAlignment="Top"
                        Opacity="0" IsHitTestVisible="False">
                <ItemsControl Focusable="False" ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource RowTemplate}" />
                <TextBlock Height="30" Text="Start Claude Code to see it here." Foreground="#99FFFFFF" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSessions}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
