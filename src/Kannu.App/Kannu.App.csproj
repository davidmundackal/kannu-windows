<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms both define Application, MessageBox, ...: every using is explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Lets the app compile (not run) on non-Windows machines and CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WFAC010 (WFO0003 from .NET 10) asks WinForms apps to set DPI mode in code. This is a WPF app (WinForms is only the tray
      icon), and WPF reads its per-monitor DPI awareness from the manifest.
    -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <ApplicationIcon>..\..\assets\Kannu.ico</ApplicationIcon>
    <AssemblyName>Kannu</AssemblyName>
    <RootNamespace>Kannu.App</RootNamespace>
    <!-- Program.Main, not the one WPF generates: Velopack's install, update and uninstall hooks run first. -->
    <!-- WPF's and WinForms' own messages in English only (about 5 MB less to download). Kannu's own
         translations live in its resources and are not affected; add a language here to bring its
         framework messages back. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StartupObject>Kannu.App.Program</StartupObject>
    <!-- LibraryImport in the shared click-through code generates marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Click-through: brings an agent's window forward. Shared with the hook. -->
    <Compile Include="..\Shared\HostProcess.cs" Link="HostProcess.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown by the Terms of Use gate and Settings › About. -->
    <EmbeddedResource Include="..\..\TERMS.md" LogicalName="TERMS.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kannu.Core\Kannu.Core.csproj" />
    <ProjectReference Include="..\Kannu.Detection\Kannu.Detection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
