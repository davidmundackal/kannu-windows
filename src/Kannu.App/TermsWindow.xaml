<Window x:Class="Kannu.App.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kannu Terms of Use"
        Width="680" Height="720" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Kannu.WindowBackground}"
        Foreground="{DynamicResource Kannu.Text}"
        FontFamily="{StaticResource Kannu.Font.Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,12" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Kannu.Icon}" Text="&#xE890;" FontSize="28" Margin="0,0,14,0"
                       Foreground="{DynamicResource Kannu.Accent}" />
            <StackPanel>
                <TextBlock x:Name="Heading" FontFamily="{StaticResource Kannu.Font.Display}" FontSize="22"
                           FontWeight="SemiBold" Text="Before you start" />
                <TextBlock x:Name="Subheading" Style="{StaticResource Kannu.RowDescription}" FontSize="13"
                           Text="Kannu starts once you accept its Terms of Use." />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="32,8,32,0" Style="{StaticResource Kannu.Card}" Padding="4">
            <FlowDocumentScrollViewer x:Name="Document" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False"
                                      Focusable="False" />
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="32,16" Background="{DynamicResource Kannu.Card}"
                BorderBrush="{DynamicResource Kannu.CardStroke}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeclineButton" Style="{StaticResource Kannu.Button}" Content="Decline" Margin="0,0,8,0"
                        Click="Decline_Click" IsCancel="True" />
                <Button x:Name="AcceptButton" Style="{StaticResource Kannu.AccentButton}" Content="Accept"
                        Click="Accept_Click" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
