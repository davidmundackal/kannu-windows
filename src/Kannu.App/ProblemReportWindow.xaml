<Window x:Class="Kannu.App.ProblemReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kannu"
        Width="600" Height="520" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Kannu.WindowBackground}"
        Foreground="{DynamicResource Kannu.Text}"
        FontFamily="{StaticResource Kannu.Font.Text}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="28,24,28,12" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Kannu.Icon}" Text="&#xE7BA;" FontSize="26" Margin="0,0,14,0"
                       Foreground="{DynamicResource Kannu.Accent}" VerticalAlignment="Top" />
            <StackPanel MaxWidth="480">
                <TextBlock x:Name="Heading" FontFamily="{StaticResource Kannu.Font.Display}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="Explanation" Style="{StaticResource Kannu.RowDescription}" FontSize="13" Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="28,4,28,0" Style="{StaticResource Kannu.Card}" Padding="2">
            <TextBox x:Name="ReportText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Kannu.Text}"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="10" />
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="28,14" Background="{DynamicResource Kannu.Card}"
                BorderBrush="{DynamicResource Kannu.CardStroke}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource Kannu.LinkButton}" Content="Show in folder"
                        VerticalAlignment="Center" Click="ShowInFolder_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Kannu.Button}" Content="Not now" Margin="0,0,8,0" IsCancel="True" Click="Close_Click" />
                    <Button Style="{StaticResource Kannu.Button}" Content="Copy report" Margin="0,0,8,0" Click="Copy_Click" />
                    <Button Style="{StaticResource Kannu.AccentButton}" Content="Report on GitHub" IsDefault="True" Click="Report_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
